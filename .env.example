# Convoy GPS Tracking - Environment Variables
# Copy this file to .env and update values

# Database Configuration
DB_NAME=convoy_db
DB_USER=postgres
DB_PASSWORD=change_this_password_in_production
DB_PORT=5432

# API Configuration
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Firebase Credentials (Base64 encoded)
# To generate Base64 string:
#   Windows PowerShell: .\convert-firebase-to-base64.ps1
#   Or manually: [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-adminsdk.json"))
# Leave empty to disable Firebase notifications
FIREBASE_CREDENTIALS_BASE64=

# Security (Optional)
# JWT_SECRET=your_jwt_secret_key_here
# CORS_ORIGINS=https://yourdomain.com

# Logging (Optional)
# LOG_LEVEL=Information
