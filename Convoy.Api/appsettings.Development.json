{
  // Maxfiy qiymatlar bu yerda EMAS -> appsettings.Local.json (gitignore'da)
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Convoy.Api.Middleware.EncryptionMiddleware": "Debug"
    }
  },
  "Encryption": {
    "Enabled": false,
    "ExcludedRoutes": [
      "/api/locations",
      "/api/locations/*",
      "/api/permissions",
      "/api/permissions/*",
      "/api/signalrtest/*",
      "/api/auth/verify_number",
      "/api/auth/send_otp",
      "/api/auth/verify_otp",
      "/swagger",
      "/swagger/*",
      "/health",
      "/hubs/*"
    ]
  },
  "DailyReportSettings": {
    "RunTimeHour": 19,
    "RunTimeMinute": 30,
    "EnableAutoGeneration": true,
    "EnableTestMode": false
  }
}
